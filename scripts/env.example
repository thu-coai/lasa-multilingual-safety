# Optional environment file for LASA scripts.
#
# Usage:
#   cp scripts/env.example scripts/env.local
#   edit scripts/env.local
#   source scripts/env.local

export LASA_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Python executables. Leave as python3/accelerate if your active environment has the dependencies.
export PYTHON_BIN=python3
export ACCELERATE_BIN=accelerate

# Required paths for most runs.
export MODEL_PATH=/path/to/base_or_aligned_model
export TOKENIZER_PATH="${MODEL_PATH}"
export CLASSIFIER_DIR=/path/to/ssi_classifier
export INPUT_FILE=/path/to/input_prompts.json
export DATASET_PATH="${LASA_REPO_ROOT}/data/training/mixed_dpo_ultra_safety_converted.json"
# Bundled data defaults. Override only if you want to use another dataset copy.
export ULTRAFEEDBACK_DIR="${LASA_REPO_ROOT}/data/ultrafeedback"
export SAFETY_DATA_PATH="${LASA_REPO_ROOT}/data/ssi/unsafe_train.json"

# Optional: use a local TRL source checkout instead of the installed trl package.
# export TRL_SOURCE_DIR=/path/to/trl

# Generic SLURM options used by scripts/submit_*.sh.
# Leave PARTITION/ACCOUNT empty if your cluster does not require them.
export PARTITION=
export ACCOUNT=
export TIME=
export GPUS=1
export CPUS=4

# By default GPU jobs use: --gres=gpu:${GPUS}
# Override for clusters that use a different GPU request syntax.
# export GPU_REQUEST="--gpus-per-node=${GPUS}"

# Extra raw sbatch arguments, for example:
# export SBATCH_ARGS="--mem=64G --qos=normal"
